<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet Package Metadata -->
    <PackageId>DarkStrata.CredentialCheck.Umbraco</PackageId>
    <Version>2.4.0</Version>
    <Authors>DarkStrata</Authors>
    <Company>DarkStrata</Company>
    <Title>DarkStrata Credential Check for Umbraco</Title>
    <Description>Blocks compromised passwords for Umbraco members and backoffice users, checks backoffice logins against the DarkStrata breach corpus using k-anonymity, and receives DarkStrata alert webhooks as Umbraco notifications.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/darkstrata/darkstrata-sdks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/darkstrata/darkstrata-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco-marketplace;umbraco;security;credentials;breach;k-anonymity;password</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) DarkStrata</Copyright>

    <AssemblyName>DarkStrata.CredentialCheck.Umbraco</AssemblyName>
    <RootNamespace>DarkStrata.CredentialCheck.Umbraco</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DarkStrata.CredentialCheck.Umbraco.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Umbraco 13 LTS -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[13.5.3,14.0.0)" />
  </ItemGroup>

  <!-- Umbraco 15 / 16 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[15.1.2,17.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DarkStrata.CredentialCheck/DarkStrata.CredentialCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
