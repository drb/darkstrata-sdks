{
  "name": "darkstrata/credential-check",
  "description": "DarkStrata credential breach checking SDK using k-anonymity. Only a 5-6 character hash prefix is ever sent to the API.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "darkstrata",
    "credential",
    "breach",
    "password",
    "k-anonymity",
    "security",
    "laravel"
  ],
  "homepage": "https://darkstrata.io",
  "support": {
    "issues": "https://github.com/darkstrata/darkstrata-sdks/issues",
    "source": "https://github.com/darkstrata/darkstrata-sdks/tree/main/sdks/php"
  },
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "DarkStrata\\CredentialCheck\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DarkStrata\\CredentialCheck\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite default",
    "test:laravel": "phpunit --testsuite laravel"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "illuminate/support": "Enables the bundled Laravel integration (Laravel 11 to 13)"
  },
  "extra": {
    "laravel": {
      "providers": [
        "DarkStrata\\CredentialCheck\\Laravel\\DarkStrataServiceProvider"
      ]
    }
  }
}
