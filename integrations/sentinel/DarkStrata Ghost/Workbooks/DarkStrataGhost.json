{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## DarkStrata Ghost\nGhost (honeytoken) events from the DarkStrata Ghost connector. A `ghost.seen` event means a ghost was found in leaked data; `ghost.retired` is a tamper alarm; `ghost.verified` is the monthly proof of life for each armed ghost. Labels and corpus names are customer-written or leaked text."
      },
      "name": "header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [],
        "parameters": [
          {
            "id": "6f1b6c1e-0b8e-4c55-9d43-0d6b2f6b3a01",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 2592000000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "6f1b6c1e-0b8e-4c55-9d43-0d6b2f6b3a02",
            "version": "KqlParameterItem/1.0",
            "name": "IncludeTest",
            "label": "Self-test events",
            "type": 2,
            "isRequired": true,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[{\"value\":\"false\",\"label\":\"Exclude\",\"selected\":true},{\"value\":\"true\",\"label\":\"Include\"}]",
            "value": "false"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "DarkStrataGhostEvents_CL\n| where {IncludeTest} or not(IsTest)\n| summarize Events = count() by EventType, bin(TimeGenerated, 1d)",
        "size": 0,
        "title": "Ghost events over time",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart"
      },
      "name": "events-over-time"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "DarkStrataGhostEvents_CL\n| where {IncludeTest} or not(IsTest)\n| where EventType == \"ghost.seen\"\n| summarize Sightings = count() by Kind",
              "size": 3,
              "title": "Sightings by kind",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "customWidth": "50"
            },
            "name": "by-kind"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "DarkStrataGhostEvents_CL\n| where {IncludeTest} or not(IsTest)\n| where EventType == \"ghost.seen\"\n| summarize Sightings = count() by Severity\n| extend Order = indexof(\"INFO,LOW,MEDIUM,HIGH,CRITICAL\", Severity)\n| sort by Order asc\n| project Severity, Sightings",
              "size": 3,
              "title": "Sightings by severity",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "customWidth": "50"
            },
            "name": "by-severity"
          }
        ]
      },
      "name": "breakdown"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "DarkStrataGhostEvents_CL\n| where {IncludeTest} or not(IsTest)\n| where EventType == \"ghost.seen\"\n| sort by TimeGenerated desc\n| project TimeGenerated, Kind, Severity, Label = GhostLabel, Corpus = CorpusName, MatchKind, MatchSource, IsTest, ConsoleUrl\n| take 100",
        "size": 0,
        "title": "Latest sightings",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ConsoleUrl",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url",
                "linkLabel": "Open in DarkStrata"
              }
            }
          ],
          "filter": true
        }
      },
      "name": "latest-sightings"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "DarkStrataGhostEvents_CL\n| where {IncludeTest} or not(IsTest)\n| where EventType == \"ghost.retired\"\n| sort by TimeGenerated desc\n| project TimeGenerated, Label = GhostLabel, RetiredBy = RetiredByName, Reason = iff(isempty(RetiredReason), \"manual\", RetiredReason), IsTest, ConsoleUrl",
        "size": 0,
        "title": "Tamper events (ghost retired)",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ConsoleUrl",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url",
                "linkLabel": "Open in DarkStrata"
              }
            }
          ],
          "filter": true
        },
        "noDataMessage": "No ghosts retired in this time range."
      },
      "name": "tamper-events"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "DarkStrataGhostEvents_CL\n| where TimeGenerated > ago(90d) and not(IsTest)\n| summarize LastVerified = maxif(TimeGenerated, EventType == \"ghost.verified\"), Deployed = maxif(TimeGenerated, EventType == \"ghost.deployed\"), Retired = maxif(TimeGenerated, EventType == \"ghost.retired\"), LastCheckedAt = max(LastCheckedAt), Label = take_any(GhostLabel), ConsoleUrl = take_any(ConsoleUrl) by GhostId\n| where isnull(Retired)\n| extend Status = iff(coalesce(LastVerified, Deployed) < ago(33d), \"Not armed\", \"Armed\")\n| project Label, Status, LastVerified, LastCheckedAt, ConsoleUrl\n| sort by Status desc, LastVerified asc",
        "size": 0,
        "title": "Proof of life per ghost (fixed 90 days; a live ghost not verified in 33 days is no longer armed)",
        "timeContext": {
          "durationMs": 7776000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ConsoleUrl",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url",
                "linkLabel": "Open in DarkStrata"
              }
            }
          ],
          "filter": true
        },
        "noDataMessage": "No ghosts retired in this time range."
      },
      "name": "proof-of-life"
    }
  ],
  "fallbackResourceIds": [],
  "fromTemplateId": "sentinel-DarkStrataGhost",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
